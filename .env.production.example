# Production environment for a VPS. Copy to `.env` next to docker-compose.prod.yml.
# Never commit the filled-in file.
#
# On the server:
#   cp .env.production.example .env
#   nano .env

# ── Image ────────────────────────────────────────────────────────────────────
# Must match the tag you loaded with `docker load`.
FUSHI_IMAGE=fushi:1.0

# ── Discord ──────────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → Bot → Token.
# Prefer a freshly regenerated token if this one has ever been pasted into a chat.
Discord__Token=

# Leave empty so slash commands register globally (takes up to ~1 hour on first
# deploy). Set to a guild snowflake only while testing.
Discord__DevelopmentGuildId=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=fushi
POSTGRES_USER=fushi
# Generate something long and random. Do not reuse the development password.
#   openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# ── Schema ───────────────────────────────────────────────────────────────────
# true is fine for a single bot instance. Set false if you apply migrations by hand.
Database__ApplyMigrationsOnStartup=true

# ── Telemetry (optional) ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fushi
