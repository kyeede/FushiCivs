{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Discord": {
    "ReconnectBackoffCeilingSeconds": 60,
    "IntakePageSize": 100
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Scheduler": {
    "TickSeconds": 30,
    "IntakeSeconds": 120,
    "IntakeEnabled": true,
    "IntakeBatchSize": 50,
    "RegistrationSeconds": 300,
    "RegistrationEnabled": true
  }
}
