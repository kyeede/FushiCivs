# Copy to .env and fill in. .env is gitignored; this file is the tracked
# template, so add every new variable here (without its value) when you
# introduce one.
#
# Configuration precedence, lowest to highest:
#   appsettings.json  <  appsettings.{Environment}.json  <  user secrets  <  environment
#
# The double underscore in a variable name is the .NET configuration separator:
# Discord__Token binds to the "Token" key of the "Discord" section.

# ── Runtime ──────────────────────────────────────────────────────────────────
DOTNET_ENVIRONMENT=Development

# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Token.
# Treat as a credential: anyone holding it controls the bot account.
Discord__Token=

# Restricting slash-command registration to one guild makes commands appear
# instantly instead of waiting on Discord's global propagation. Leave empty in
# production to register globally.
Discord__DevelopmentGuildId=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=fushi
POSTGRES_USER=fushi
POSTGRES_PASSWORD=fushi_dev
POSTGRES_HOST_PORT=5432

ConnectionStrings__Database=Host=localhost;Port=5432;Database=fushi;Username=fushi;Password=fushi_dev

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Leave empty to run with the in-memory cache tier only. Set it to enable the
# distributed second tier of HybridCache.
REDIS_HOST_PORT=6379
ConnectionStrings__Redis=

# ── Telemetry (optional) ─────────────────────────────────────────────────────
# Unset disables the OTLP exporter; traces and metrics still emit locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fushi

# ── Scheduler (optional overrides) ───────────────────────────────────────────
# Scheduler__RegistrationSeconds=300
# Scheduler__RegistrationEnabled=true
