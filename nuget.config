<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Exactly one upstream source. Every additional feed widens the substitution
    surface for a dependency-confusion attack, so new feeds must be paired with
    an explicit packageSourceMapping entry below.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    With a single source this mapping looks redundant, but it is what makes the
    single-source guarantee enforceable: any feed added later without a matching
    pattern resolves nothing instead of silently shadowing nuget.org packages.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="allowInsecureConnections" value="false" />
  </config>

  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
</configuration>
